# Banco Turso — obrigatórias no Vercel
TURSO_DATABASE_URL=libsql://SEU-BANCO-SUA-CONTA.turso.io
TURSO_AUTH_TOKEN=SEU_TOKEN_PRIVADO_DO_TURSO
SESSION_SECRET=CRIE_UMA_FRASE_ALEATORIA_COM_PELO_MENOS_24_CARACTERES

# Limite diário por navegador/dispositivo
AI_DAILY_LIMIT=20

# IA: Groq principal, Gemini 3.5 Flash-Lite como contingência e modo offline final
AI_PROVIDER=groq
AI_FALLBACK_ORDER=groq,gemini,offline
AI_TIMEOUT_MS=18000

# Groq
GROQ_API_KEY=
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_DEEP_MODEL=qwen/qwen3.6-27b

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
